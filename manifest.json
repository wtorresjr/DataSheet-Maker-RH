{
  "manifest_version": 3,
  "name": "RH DataSheet Maker",
  "version": "1.0.0",
  "description": "Scrape Raven Health treatment plans and build printable session data sheets.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.ravenhealth.com/clients/*/care-plan"],
      "js": ["src/content/scrape.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RH DataSheet Maker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/builder/*"],
      "matches": ["https://app.ravenhealth.com/*"]
    }
  ]
}
